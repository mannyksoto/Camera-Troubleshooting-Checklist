@echo off
REM ============================================================
REM  Camera Troubleshooting Checklist - Launcher
REM  Double-click this file to run the app.
REM ============================================================

setlocal
cd /d "%~dp0"

where python >nul 2>nul
if %errorlevel%==0 (
    set PYCMD=python
    goto :havepython
)

where py >nul 2>nul
if %errorlevel%==0 (
    set PYCMD=py
    goto :havepython
)

echo.
echo ============================================================
echo   Python was not found on this computer.
echo.
echo   This tool needs Python 3 installed once before it can run.
echo   1. Go to https://www.python.org/downloads/
echo   2. Download and run the installer
echo   3. IMPORTANT: check the box "Add python.exe to PATH"
echo      before clicking Install. Leave "tcl/tk and IDLE" checked
echo      too (it's checked by default) -- the app's window needs it.
echo   4. After it finishes, double-click this file again
echo ============================================================
echo.
pause >nul
goto :eof

:havepython
%PYCMD% -c "import tkinter" >nul 2>nul
if %errorlevel% neq 0 (
    echo.
    echo ============================================================
    echo   Python is installed, but the window toolkit (tkinter^)
    echo   is missing. Re-run the Python installer, choose "Modify",
    echo   and make sure "tcl/tk and IDLE" is checked.
    echo ============================================================
    echo.
    pause >nul
    goto :eof
)

%PYCMD% -c "import docx" >nul 2>nul
if %errorlevel% neq 0 (
    echo Setting up required component - one-time, please wait...
    %PYCMD% -m pip install --quiet python-docx
)

%PYCMD% camera_troubleshooter_gui.py

:eof
